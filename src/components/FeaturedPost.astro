---
import { FEATURED_IMAGE_HEIGHT, FEATURED_IMAGE_WIDTH } from '../utils/blog';

interface Props {
  title: string;
  date: Date;
  category: string;
  description: string;
  slug: string;
  categorySlug: string;
  image?: string | null;
  readTime?: number;
}

const { title, date, category, description, slug, categorySlug, image, readTime } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .format(date)
  .replace(/\//g, '.');
const dateTime = date.toISOString().split('T')[0];
---

<article class="featured-post" aria-labelledby="featured-post-title">
  <div class="featured-post__head">
    <span class="featured-post__label">Latest</span>
    <span class="featured-post__divider" aria-hidden="true">/</span>
    <a href={categorySlug} class="featured-post__category">{category}</a>
  </div>

  <a href={slug} class="featured-post__media" tabindex="-1" aria-hidden="true">
    {image ? (
      <img
        src={image}
        alt=""
        width={FEATURED_IMAGE_WIDTH}
        height={FEATURED_IMAGE_HEIGHT}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="featured-post__placeholder" aria-hidden="true">
        <span class="featured-post__placeholder-label">{category}</span>
      </div>
    )}
  </a>

  <div class="featured-post__body">
    <h2 id="featured-post-title" class="featured-post__title">
      <a href={slug}>{title}</a>
    </h2>
    <p class="featured-post__description">{description}</p>
    <div class="featured-post__footer">
      <span class="featured-post__meta">
        <time datetime={dateTime}>{formattedDate}</time>
        {readTime && (
          <>
            <span aria-hidden="true">·</span>
            <span>{readTime} min</span>
          </>
        )}
      </span>
      <a class="featured-post__cta" href={slug}>
        Read article
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
