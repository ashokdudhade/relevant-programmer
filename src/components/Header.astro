---
import { siteMetadata } from '../data/site';

const { title: blogName, menu } = siteMetadata;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${blogName} — home`}>
      <span class="site-header__mark" aria-hidden="true">[rp]</span>
      <span class="site-header__title">{blogName}</span>
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul class="site-header__nav-list">
        {menu.map((item) => {
          const isActive = item.path === '/'
            ? (Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/posts/'))
            : Astro.url.pathname === item.path;
          return (
            <li class="site-header__nav-item">
              <a
                href={item.path}
                class:list={['site-header__nav-link', isActive && 'site-header__nav-link--active']}
              >
                {item.label}
              </a>
            </li>
          );
        })}
        <li class="site-header__nav-item">
          <a
            href="/categories/"
            class:list={[
              'site-header__nav-link',
              Astro.url.pathname.startsWith('/categories') && 'site-header__nav-link--active',
            ]}
          >
            Topics
          </a>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      class="site-header__theme-toggle"
      id="theme-toggle"
      aria-label="Toggle theme"
      title="Toggle theme"
    >
      <svg class="site-header__theme-icon site-header__theme-icon--sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true">
        <circle cx="8" cy="8" r="3" />
        <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.5 1.5M11.5 11.5L13 13M3 13l1.5-1.5M11.5 4.5L13 3" />
      </svg>
      <svg class="site-header__theme-icon site-header__theme-icon--moon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M6 1.5A6.5 6.5 0 1 0 14.5 10a5 5 0 0 1-8.5-8.5z" />
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var current = document.documentElement.getAttribute('data-theme') || 'light';
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      var meta = document.querySelector('meta[name="theme-color"]:not([media])');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#0a0a0a' : '#ffffff');
    });
  })();
</script>
