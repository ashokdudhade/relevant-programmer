---
import { siteMetadata } from '../data/site';

const { author, title: blogName, menu } = siteMetadata;
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__start">
      <a href="/" class="site-header__brand">
        <span class="site-header__mark" aria-hidden="true"></span>
        <span class="site-header__title">{blogName}</span>
      </a>
      <nav class="site-header__nav" aria-label="Main">
        <ul class="site-header__nav-list">
          {menu.map((item) => {
            const isActive = item.path === '/'
              ? (Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/posts/'))
              : Astro.url.pathname === item.path;
            return (
              <li class="site-header__nav-item">
                <a
                  href={item.path}
                  class:list={['site-header__nav-link', isActive && 'site-header__nav-link--active']}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
    <a
      href="/about/"
      class:list={['site-header__avatar', Astro.url.pathname === '/' && 'site-header__avatar--hidden-home']}
      aria-label={`About ${author.name}`}
    >
      <img
        src="/profile-pic.jpg"
        class="site-header__photo"
        width="32"
        height="32"
        alt=""
      />
    </a>
  </div>
</header>
