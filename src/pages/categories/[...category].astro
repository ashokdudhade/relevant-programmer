---
import Layout from '../../layouts/Layout.astro';
import Post from '../../components/Post.astro';
import { getCollection } from 'astro:content';
import { siteMetadata } from '../../data/site';
import { categorySlug, postPath, extractFirstImage } from '../../utils/blog';
import { formatTaxonomyName, taxonomyDescription } from '../../utils/seo';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const categorySet = new Set(posts.map((p) => p.data.category.toLowerCase().replace(/\s+/g, '-')));
  return Array.from(categorySet).map((category) => ({
    params: { category },
    props: { categorySlug: category },
  }));
}

const { categorySlug: categoryParam } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category.toLowerCase().replace(/\s+/g, '-') === categoryParam)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabel = posts[0]?.data.category ?? formatTaxonomyName(categoryParam);
const description = taxonomyDescription(categoryLabel, posts.length, 'category');
const canonical = `/categories/${categoryParam}/`;
---

<Layout
  title={`${categoryLabel} - ${siteMetadata.title}`}
  description={description}
  canonical={canonical}
>
  <main id="main-content" class="content">
    <div class="content__inner">
      <h1 class="page__title">{categoryLabel}</h1>
      <div class="post-list post-list--grid">
        {posts.map((entry) => (
          <Post
            variant="card"
            title={entry.data.title}
            date={entry.data.date}
            category={entry.data.category}
            description={entry.data.description}
            slug={postPath(entry.data.path)}
            categorySlug={categorySlug(entry.data.category)}
            image={extractFirstImage(entry.body)}
          />
        ))}
      </div>
    </div>
  </main>
</Layout>
