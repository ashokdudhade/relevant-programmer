---
import Layout from '../../layouts/Layout.astro';
import Post from '../../components/Post.astro';
import { getCollection } from 'astro:content';
import { siteMetadata } from '../../data/site';
import { categorySlug, postPath, extractFirstImage } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const categorySet = new Set(posts.map((p) => p.data.category.toLowerCase().replace(/\s+/g, '-')));
  return Array.from(categorySet).map((category) => ({
    params: { category },
    props: { categorySlug: category },
  }));
}

const { categorySlug: categoryParam } = Astro.props;
const categoryName = categoryParam.replace(/-/g, ' ');
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category.toLowerCase().replace(/\s+/g, '-') === categoryParam)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`${categoryName} - ${siteMetadata.title}`} description={siteMetadata.subtitle}>
  <main id="main-content" class="content">
    <div class="content__inner">
      <h1 class="page__title">{categoryName}</h1>
      <div class="post-list post-list--grid">
        {posts.map((entry) => (
          <Post
            variant="card"
            title={entry.data.title}
            date={entry.data.date}
            category={entry.data.category}
            description={entry.data.description}
            slug={postPath(entry.data.path)}
            categorySlug={categorySlug(entry.data.category)}
            image={extractFirstImage(entry.body)}
          />
        ))}
      </div>
    </div>
  </main>
</Layout>
