---
import Layout from '../layouts/Layout.astro';
import Post from '../components/Post.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import { getCollection } from 'astro:content';
import { siteMetadata } from '../data/site';
import {
  categorySlug,
  postPath,
  extractFirstImage,
  getCategoryCounts,
  estimateReadTime,
} from '../utils/blog';
import { DEFAULT_DESCRIPTION } from '../utils/seo';
import { buildHomeSchema } from '../utils/schema';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [featured, ...rest] = posts;
const categories = getCategoryCounts(posts);
const featuredImage = featured ? extractFirstImage(featured.body) : null;
const featuredReadTime = featured ? estimateReadTime(featured.body) : undefined;

const postCount = posts.length;
const topicCount = categories.length;
const lastUpdated = posts[0]
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(posts[0].data.date)
  : null;
---

<Layout
  title={`${siteMetadata.title} — notes on AI, systems, and production software`}
  description={DEFAULT_DESCRIPTION}
  canonical="/"
  image={featuredImage}
  jsonLd={buildHomeSchema()}
>
  <main id="main-content" class="content content--home">
    <section class="home__hero" aria-labelledby="home-intro">
      <div class="home__intro">
        <p class="home__eyebrow">
          <span class="home__eyebrow-mark" aria-hidden="true">●</span>
          {siteMetadata.author.name} — {siteMetadata.subtitle}
        </p>
        <h1 id="home-intro" class="home__title">
          Notes on <em>AI</em>, systems, and shipping software that holds up in production.
        </h1>
        <p class="home__lede">
          Long-form writing on engineering, agentic tools, and the lessons that only show up after deploy.
        </p>
        <div class="home__actions">
          <a class="home__action home__action--primary" href="#home-posts">
            Read articles
            <span aria-hidden="true">→</span>
          </a>
          <a class="home__action home__action--secondary" href="/about/">
            About
          </a>
        </div>
      </div>

      {featured && (
        <FeaturedPost
          title={featured.data.title}
          date={featured.data.date}
          category={featured.data.category}
          description={featured.data.description}
          slug={postPath(featured.data.path)}
          categorySlug={categorySlug(featured.data.category)}
          image={featuredImage}
          readTime={featuredReadTime}
        />
      )}
    </section>

    <div class="home__statusbar" role="presentation">
      <span class="home__statusbar-item">
        <span class="home__statusbar-key">articles</span>
        <span class="home__statusbar-val">{String(postCount).padStart(2, '0')}</span>
      </span>
      <span class="home__statusbar-item">
        <span class="home__statusbar-key">topics</span>
        <span class="home__statusbar-val">{String(topicCount).padStart(2, '0')}</span>
      </span>
      {lastUpdated && (
        <span class="home__statusbar-item">
          <span class="home__statusbar-key">updated</span>
          <span class="home__statusbar-val">{lastUpdated}</span>
        </span>
      )}
      <span class="home__statusbar-item home__statusbar-item--feed">
        <a href="/llms.txt" class="home__statusbar-link">llms.txt</a>
        <span aria-hidden="true">·</span>
        <a href="/rss.xml" class="home__statusbar-link">rss</a>
        <span aria-hidden="true">·</span>
        <a href={`https://github.com/${siteMetadata.author.github}`} class="home__statusbar-link" rel="noopener">github</a>
      </span>
    </div>

    <section class="home__section home__section--topics" aria-labelledby="home-topics">
      <header class="home__section-header">
        <h2 id="home-topics" class="home__section-title">
          <span class="home__section-marker" aria-hidden="true">/</span> topics
        </h2>
        <a class="home__section-link" href="/categories/">all topics →</a>
      </header>
      <nav class="home__topics" aria-label="Topics">
        {categories.slice(0, 8).map(({ name, count, slug }) => (
          <a class="home__topic" href={slug}>
            <span class="home__topic-name">{name}</span>
            <span class="home__topic-count">{String(count).padStart(2, '0')}</span>
          </a>
        ))}
      </nav>
    </section>

    {rest.length > 0 && (
      <section id="home-posts" class="home__section home__section--posts" aria-labelledby="home-posts-heading">
        <header class="home__section-header">
          <h2 id="home-posts-heading" class="home__section-title">
            <span class="home__section-marker" aria-hidden="true">/</span> articles
          </h2>
          <span class="home__section-meta">{postCount} total</span>
        </header>
        <div class="post-list post-list--grid">
          {rest.map((entry, idx) => (
            <Post
              variant="card"
              index={idx + 1}
              title={entry.data.title}
              date={entry.data.date}
              category={entry.data.category}
              description={entry.data.description}
              slug={postPath(entry.data.path)}
              categorySlug={categorySlug(entry.data.category)}
              image={extractFirstImage(entry.body)}
            />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
